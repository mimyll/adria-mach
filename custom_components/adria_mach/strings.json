  "exceptions": {
    "controls_blocked": {
      "message": "A fresh state check or storage repair is required. A new manual request resynchronizes before dispatch; old commands are never replayed."
    },
    "control_busy": {
      "message": "A command is already in progress."
    },
    "invalid_control_value": {
      "message": "This value is not supported by the light, temperature or water-heating control."
    },
    "test_case_complete": {
      "message": "This bounded test case is complete. Another batch is not enabled."
    },
    "control_preflight_failed": {
      "message": "No command sent: baseline, definition or connection did not satisfy preflight."
    },
    "legacy_restore_required": {
      "message": "A previous bounded test awaits its original OFF restoration. Complete that test before another control."
    },
    "probe_busy": {
      "message": "A read probe or command is active. Wait for it to finish."
    },
    "probe_failed": {
      "message": "The read probe did not complete. Inspect integration diagnostics; the control interlock is unchanged."
    },
    "light_queue_failed": {
      "message": "The request expired, the queue is full or the integration was stopped. Inspect current state before a new request."
    },
    "equipment_not_enabled": {
      "message": "The optional equipment has not been identified in integration options."
    }
  },
